{
  "name": "judgement-crucible",
  "version": "1.0.0",
  "private": true,
  "description": "A live, multiplayer executive judgment simulation for CISO leaders.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern test-results --ignore-pattern playwright-report",
    "typecheck": "tsc --noEmit",
    "validate:scenario": "python3 spec/trusted-path-v2/validate_package.py",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run validate:scenario && npm run build"
  },
  "dependencies": {
    "firebase": "^12.1.0",
    "firebase-admin": "^13.5.0",
    "next": "16.2.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
