    {
      "test_id": "T4",
      "name": "Governance failure",
      "steps": [
        {
          "call_id": "C1",
          "option": "C1-C",
          "inputs": {
            "judgment": {
              "owner": false
            }
          }
        },
        {
          "call_id": "C2",
          "option": "C2-D",
          "inputs": {
            "interim_recommendation": false
          }
        },
        {
          "call_id": "C3",
          "option": "C3-D",
          "inputs": {}
        },
        {
          "call_id": "C4",
          "option": "C4-D",
          "inputs": {
            "interim_recommendation": false
          }
        }
      ],
      "expected_after_call4": {
        "visible": {
          "continuity": 5,
          "trust": 6,
          "truth": 7
