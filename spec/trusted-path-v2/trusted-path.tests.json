  "experience_fixtures": [
    {
      "test_id": "UX-01",
      "given": "15 participants join by room code and confirm readiness",
      "assert": [
        "no_account_creation",
        "joined_count_15",
        "host_only_phase_advance"
      ]
    },
    {
      "test_id": "UX-02",
      "given": "votes split A6/B4/C3/D2",
      "assert": [
        "aggregate_distribution_only",
        "no_participant_names",
        "no_correctness_cue"
      ]
    },
    {
      "test_id": "UX-03",
      "given": "Chair clock expires once and decision arrives in grace period",
      "assert": [
        "one_hesitation_event",
        "continuity_minus_one",
        "resulting_state_visible"
      ]
    },
    {
      "test_id": "UX-04",
      "given": "Chair selects C4-A but speaks C4-C assurance",
      "assert": [
        "H-RECON_blocks_advance",
        "unresolved_maps_to_C4-C",
        "FACILITATOR_RECONCILED_logged"
      ]
    },
    {
      "test_id": "UX-05",
      "given": "phone disconnects after selection before acknowledgment",
      "assert": [
        "selection_retained",
        "idempotent_resubmit",
        "at_most_one_vote"
      ]
    },
    {
      "test_id": "UX-06",
      "given": "room display refreshes during hidden-state resolution",
      "assert": [
        "recovering_screen",
        "no_hidden_state_flash",
        "latest_approved_snapshot"
      ]
    },
    {
      "test_id": "UX-07",
      "given": "same decision trail replayed twice",
      "assert": [
        "identical_visible_state",
        "identical_debt",
        "identical_monday_selection",
        "identical_screen_ids"
      ]
    },
    {
      "test_id": "UX-08",
      "given": "reduced motion and high contrast enabled",
      "assert": [
        "complete_information",
        "complete_controls",
        "no_motion_dependency",
        "no_color_only_meaning"
      ]
    }
  ]
}
