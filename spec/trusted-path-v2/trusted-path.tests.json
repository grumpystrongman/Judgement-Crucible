    {
      "test_id": "T5",
      "name": "Hesitation",
      "steps": [
        {
          "call_id": "C1",
          "option": "C1-A",
          "inputs": {},
          "hesitation": true
        },
        {
          "call_id": "C2",
          "option": "C2-A",
          "inputs": {
            "decision_right_explicit": true
