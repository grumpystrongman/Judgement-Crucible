{
  "package_id": "cyber-ronin.judgment-crucible.trusted-path.tests",
  "version": "2.0.0",
  "rules_fixtures": [
    {
      "test_id": "T1",
      "name": "Containment",
      "steps": [
        {
          "call_id": "C1",
          "option": "C1-A",
          "inputs": {}
        },
        {
          "call_id": "C2",
          "option": "C2-A",
          "inputs": {
            "decision_right_explicit": true
          }
        },
        {
          "call_id": "C3",
          "option": "C3-A",
          "inputs": {}
        },
        {
          "call_id": "C4",
          "option": "C4-B",
          "inputs": {}
        }
      ],
      "expected_after_call4": {
        "visible": {
          "continuity": 1,
          "trust": 10,
          "truth": 10
        },
        "debt": {
          "exposure": 0,
          "trust": 0,
          "evidence": 0,
          "alignment": 0
        }
      },
      "expected_monday": {
        "selected": [],
        "final_visible": {
          "continuity": 1,
          "trust": 10,
          "truth": 10
        }
      }
    },
    {
      "test_id": "T2",
      "name": "Compounding risk",
      "steps": [
        {
          "call_id": "C1",
          "option": "C1-B",
          "inputs": {}
        },
        {
          "call_id": "C2",
          "option": "C2-B",
          "inputs": {}
        },
        {
          "call_id": "C3",
          "option": "C3-B",
          "inputs": {}
        },
        {
          "call_id": "C4",
          "option": "C4-C",
          "inputs": {}
        }
      ],
      "expected_after_call4": {
        "visible": {
          "continuity": 10,
          "trust": 7,
          "truth": 2
        },
        "debt": {
          "exposure": 2,
          "trust": 2,
          "evidence": 1,
          "alignment": 0
        },
        "flags": {
          "EXPOSURE_INCIDENT_APPLIED": true
        }
      },
      "expected_monday": {
        "selected": [
          "MON-TRUST-2",
          "MON-EXPOSURE-2"
