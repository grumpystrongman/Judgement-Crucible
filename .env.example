# Local Firebase client configuration. Firebase App Hosting injects equivalent
# configuration automatically when the backend is connected to a Firebase web app.
# Copy to .env.local only when you want local development to use Firebase instead
# of the built-in local JSON session store.
NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"...","authDomain":"your-project.firebaseapp.com","databaseURL":"https://your-project-default-rtdb.firebaseio.com","projectId":"your-project","storageBucket":"your-project.firebasestorage.app","messagingSenderId":"...","appId":"..."}

# Optional server override. App Hosting populates FIREBASE_CONFIG automatically.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Optional abuse protection. Enable after configuring Firebase App Check with a
# reCAPTCHA Enterprise site key for the production domain.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
REQUIRE_APP_CHECK=false

# Used for canonical metadata in non-App-Hosting environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
